# EcoStep QCU IPT2 Desktop App Configuration Template
# Copy to ".env" or configure directly via the in-app Setup dialogs.

# Local PostgreSQL 16/18 (3NF Database)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=ecostep_qcu_db

# SIA101 Web App Bridge (Render URL or http://127.0.0.1:5000)
SIA_BRIDGE_URL=
SIA_API_KEY=
SIA_TILE_ID=TILE-01
SIA_AUTO_SYNC=true
SIA_SYNC_INTERVAL_SEC=15
